{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-check.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking sync with origin/main..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)",
      "Bash(npm run dev)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
