{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-check.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking sync with origin/main..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git switch -c agent/*)", "Bash(git switch agent/*)", "Bash(git switch --detach origin/main)",
      "Bash(git add *)", "Bash(git commit *)",
      "Bash(git push -u origin agent/*)", "Bash(git push origin agent/*)",
      "Bash(gh pr create --draft *)", "Bash(gh pr view *)", "Bash(gh pr checks *)",
      "Bash(npm run test:run *)", "Bash(npm run lint *)", "Bash(npm run build *)", "Bash(npm run build:test *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(supabase link *)", "Bash(npx supabase link *)",
      "Bash(supabase db push *)", "Bash(npx supabase db push *)",
      "Bash(npm run dev *)", "Bash(npx vite *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push origin main *)",
      "Bash(git add -f *)", "Bash(git add --force *)",
      "Bash(git add .)", "Bash(git add -A *)", "Bash(git add --all *)",
      "Bash(git push *:main*)",
      "PowerShell",
      "Bash(npm run test:e2e:clean *)", "Bash(supabase db reset *)", "Bash(npx supabase db reset *)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  }
}
