    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "env:test": "node scripts/write-env-test.mjs",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 5173 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.108.0",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/react-query": "^5.59.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "exceljs": "^4.4.0",
    "globals": "^15.15.0",
    "jiti": "^2.7.0",
    "postcss": "^8.4.47",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
